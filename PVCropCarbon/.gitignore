logs/*
work/*
outputs/*
!logs/.gitkeep
!work/.gitkeep
!outputs/.gitkeep

# 运行登记（provenance）进版本库
!outputs/manifests/
outputs/manifests/*
!outputs/manifests/experiment_registry.csv

# 审计报告（文本 provenance）进版本库；大矢量/栅格产物不进
!outputs/audits/
outputs/audits/*
!outputs/audits/*.md
!outputs/audits/*.json
!outputs/audits/*.csv

__pycache__/
*.pyc

# Word/Office 临时锁文件
~$*
